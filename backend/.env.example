# =========================
# Entorno
# =========================
DEBUG=True
SECRET_KEY=replace-with-strong-secret-key

# Hosts permitidos (separados por coma)
ALLOWED_HOSTS=localhost,127.0.0.1,oficioya.onrender.com

# Compatibilidad legacy (si ALLOWED_HOSTS no existe)
ALLOWED_HOSTS_DEBUG=*

# Host inyectado por Render (opcional)
# RENDER_EXTERNAL_HOSTNAME=oficioya-backend.onrender.com

# Origenes CORS permitidos (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081

# =========================
# Base de datos
# =========================
# Desarrollo local (usado cuando DEBUG=True)
NAME_BD=oficio_ya
USER_BD=postgres
PASSWORD_BD=replace-local-db-password
HOST_BD=localhost
PORT_BD=5433

# Produccion (usado cuando DEBUG=False)
DATABASE_URL=postgresql://user:password@host:5432/database

# =========================
# Cloudinary
# =========================
CLOUDINARY_CLOUD_NAME=replace-cloud-name
CLOUDINARY_API_KEY=replace-api-key
CLOUDINARY_API_SECRET=replace-api-secret
CLOUDINARY_URL=cloudinary://replace-api-key:replace-api-secret@replace-cloud-name
